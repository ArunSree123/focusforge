# Required
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Database (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/focusforge
DB_USER=focusforge
DB_PASSWORD=focusforge
# Optional
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
JWT_EXPIRATION_HOURS=72
DDL_AUTO=update
PORT=8080
